# Токен бота из Discord Developer Portal → Bot.
DISCORD_TOKEN=

# ID сервера Discord и защищённых музыкальных каналов через запятую.
DISCORD_GUILD_ID=
MUSIC_CHANNEL_IDS=

# ID каналов уборки через запятую. Пустое поле охватывает весь выбранный сервер.
CLEANUP_CHANNEL_IDS=

# Текстовые команды и ID музыкальных ботов через запятую.
MUSIC_COMMANDS=m!play
MUSIC_BOT_IDS=

# preview показывает совпадения в консоли, delete включает удаление.
CLEANUP_MODE=preview
DELETE_DELAY_SECONDS=60
DATABASE_PATH=./data/cleanup.sqlite
